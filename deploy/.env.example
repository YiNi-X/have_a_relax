# Domain and TLS
SITE_DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com
TZ=Asia/Shanghai

# Open WebUI
WEBUI_NAME=Team AI Chat
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
WEBUI_SECRET_KEY=replace-with-random-secret
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=replace-with-temporary-admin-password

# LiteLLM
LITELLM_MASTER_KEY=sk-replace-with-random-master-key
LITELLM_SALT_KEY=replace-with-random-salt-key

# PostgreSQL
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-random-db-password

# Providers
OPENAI_API_KEY=sk-replace-with-openai-api-key

# Optional Caddy basic-auth gate.
# Generate with: docker run --rm caddy:2.8 caddy hash-password --plaintext "your-access-password"
CADDY_BASIC_AUTH_HASH=
